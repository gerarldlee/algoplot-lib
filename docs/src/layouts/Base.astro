---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'algoplot — record algorithm runs as interactive players.' } = Astro.props;
const here = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => `${base}${p}`;
const guides = [
  ['getting-started', 'Getting started'],
  ['fences', 'Fences'],
  ['react', 'React'],
  ['web', 'Web'],
  ['markdown', 'Markdown'],
  ['python', 'Python'],
  ['demos', 'Demos'],
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · algoplot</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 16 16%22><rect width=%2216%22 height=%2216%22 rx=%223%22 fill=%22%237c5cff%22/><rect x=%223%22 y=%229%22 width=%222.4%22 height=%224%22 fill=%22white%22/><rect x=%226.8%22 y=%225%22 width=%222.4%22 height=%228%22 fill=%22white%22/><rect x=%2210.6%22 y=%223%22 width=%222.4%22 height=%2210%22 fill=%22white%22/></svg>" />
  </head>
  <body>
    <header class="site">
      <a class="brand" href={withBase('/')}>
        <span class="logo" aria-hidden="true"></span>
        algoplot
      </a>
      <nav aria-label="Guides">
        {guides.map(([slug, label]) => (
          <a
            href={withBase(`/guides/${slug}/`)}
            aria-current={here === `/guides/${slug}/` || here === `/guides/${slug}` ? 'page' : undefined}
          >
            {label}
          </a>
        ))}
        <a href={withBase('/api/')}>API</a>
        <a href="https://github.com/gerarldlee/algoplot-lib">GitHub</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site">
      <p>
        (c) 2026. fociilabs.com · <a href="https://github.com/gerarldlee/algoplot-lib">GitHub</a> · <a href={withBase('/')}>home</a>
      </p>
    </footer>

    <!-- Registers <algoplot-player> for every html-mode fence on the site. -->
    <script>
      import '@algoplot/web';
    </script>
  </body>
</html>
